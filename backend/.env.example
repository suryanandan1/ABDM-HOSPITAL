# Copy to .env and change the secrets before running.

# SQLAlchemy URL. SQLite now; e.g. postgresql+psycopg://user:pass@localhost/abdm later.
DATABASE_URL=sqlite:///./hospital.db

# JWT signing secret: at least 32 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret-value-1234567890
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used once by init_db.py to create the first hospital and its administrator.
HOSPITAL_NAME=City General Hospital
HOSPITAL_CODE=CGH
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123

# ---- Phase 3: AI (Mistral AI) for document extraction, suggestions and summaries ----
# Uploaded documents and assistant questions are sent to Mistral AI.
# Without a key, AI features fail gracefully and staff enter data manually.
MISTRAL_API_KEY=
AI_MODEL=mistral-large-latest
AI_OCR_MODEL=mistral-ocr-latest
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Existing LOINC mapping project (map.py + data/Loinc.csv); default is ../../mapping relative to backend/
# LOINC_MAPPING_DIR=E:/project/mapping

# Official HL7 FHIR validator (downloaded by scripts\setup_validator.ps1 into backend/tools)
# FHIR_VALIDATOR_JAR=./tools/validator_cli.jar
# JAVA_PATH=
# Terminology server used by the validator and for ICD-10 display lookups ("n/a" = offline, no code checks).
FHIR_TX_SERVER=https://tx.fhir.org

# ---- Phase 4: ABDM HIP ----
# simulation = in-process stand-in for ABDM (default); sandbox = real ABDM sandbox (dev.abdm.gov.in)
ABDM_MODE=simulation
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/api/hiecm
ABDM_CM_ID=sbx
# Issued by NHA after sandbox registration (Bridge/client ID, e.g. SBX_00XXXX). Keep the secret out of git.
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
# Facility ID (from HFR/HPR, e.g. IN02100000XX) registered as this bridge's HIP service. Set the hospital's HFR ID to the same value.
ABDM_HIP_ID=
# Public https base URL where ABDM reaches this backend; callbacks arrive at <url>/api/v3/...
ABDM_BRIDGE_URL=
ABDM_VERIFY_CALLBACKS=true
# Sandbox testing only, when no SMS gateway exists: show patient-linking OTPs on the HIP page.
ABDM_OTP_TEST_DISPLAY=false

# ---- Phase 5: ABDM HIU (same client credentials and bridge URL as the HIP) ----
# Facility ID registered as this bridge's HIU service. Received data is pushed to <ABDM_BRIDGE_URL>/api/hiu/data-push/<one-time token>.
ABDM_HIU_ID=
# Run the HL7 validator on received bundles in the background (about a minute per record).
HIU_AUTO_VALIDATE=true
